<Window x:Class="SideScreenHUD.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SideScreen HUD - 监控窗口"
        WindowStartupLocation="Manual"
        Width="1280"
        Height="760"
        MinWidth="420"
        MinHeight="300"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F7F8FA">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="#F7F8FA"
            BorderBrush="#E4E7EC"
            BorderThickness="1"
            Padding="4">
        <Grid>
            <wv2:WebView2 x:Name="WebView"
                          DefaultBackgroundColor="#F7F8FA" />

            <Grid x:Name="LoadingOverlay"
                  Background="#F7F8FA"
                  IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="LoadingTitle"
                               Text="星澪科技 · 硬件监控"
                               Foreground="#2B5FD9"
                               FontSize="20"
                               FontWeight="Medium"
                               FontFamily="Noto Sans SC, Microsoft YaHei UI, Segoe UI"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadingText"
                               Text="正在目标屏幕上初始化监控窗口..."
                               Foreground="#5B6472"
                               FontSize="14"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
