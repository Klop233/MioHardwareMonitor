<Window x:Class="SideScreenHUD.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="星澪硬件监控 — 管理面板"
        Icon="pack://application:,,,/Assets/app.ico"
        ShowInTaskbar="True"
        Width="1120"
        Height="630"
        MinWidth="960"
        MinHeight="540"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgPage}"
        Foreground="{DynamicResource TextMain}"
        FontFamily="Noto Sans SC, Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <!-- 星澪科技 Web UI 规范 v1.0 Token（默认浅色，代码实时同步深色） -->
        <SolidColorBrush x:Key="BgPage" Color="#F7F8FA" />
        <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgHover" Color="#F1F3F5" />
        <SolidColorBrush x:Key="BorderToken" Color="#E4E7EC" />
        <SolidColorBrush x:Key="BorderStrong" Color="#8A94A3" />
        <SolidColorBrush x:Key="TextMuted" Color="#5B6472" />
        <SolidColorBrush x:Key="TextMain" Color="#1F2937" />
        <SolidColorBrush x:Key="Accent" Color="#2B5FD9" />
        <SolidColorBrush x:Key="AccentHover" Color="#234DB5" />
        <SolidColorBrush x:Key="AccentText" Color="#2B5FD9" />
        <SolidColorBrush x:Key="AccentSubtle" Color="#EAF1FB" />
        <SolidColorBrush x:Key="Success" Color="#1F7A4A" />
        <SolidColorBrush x:Key="SuccessSubtle" Color="#E7F4EC" />
        <SolidColorBrush x:Key="Warning" Color="#8A5300" />
        <SolidColorBrush x:Key="WarningSubtle" Color="#FFF3DC" />
        <SolidColorBrush x:Key="Danger" Color="#B42318" />
        <SolidColorBrush x:Key="DangerSubtle" Color="#FDECEA" />

        <!-- 次要按钮：高 36px，圆角 4px -->
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderToken}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderToken}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主要按钮（一屏唯一操作蓝）：高 36px，圆角 4px -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderToken}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮（平时红描边，悬停浅红底） -->
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏导航项（规范 08：未选透明，悬停浅灰，选中浅蓝底蓝字） -->
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActiveNavButton" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏页面切换分段按钮 -->
        <Style TargetType="Button" x:Key="SegButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActiveSegButton" BasedOn="{StaticResource SegButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 固定位置预设按钮 -->
        <Style TargetType="Button" x:Key="PresetButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderToken}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style TargetType="Button" x:Key="ActivePresetButton" BasedOn="{StaticResource PresetButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- 皮肤色块选择按钮（支持键盘聚焦与悬停反馈） -->
        <Style TargetType="Button" x:Key="SkinChipButton">
            <Setter Property="Background" Value="{DynamicResource BgPage}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderToken}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActiveSkinChipButton" BasedOn="{StaticResource SkinChipButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框：高 36px，圆角 4px -->
        <Style TargetType="ComboBox" x:Key="SpecCombo">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource TextMuted}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="300"
                                        Background="{DynamicResource BgSurface}"
                                        BorderBrush="{DynamicResource BorderToken}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtle}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框（支持 Tag 占位提示文字）：高 36px，圆角 4px -->
        <Style TargetType="TextBox" x:Key="SpecTextBox">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="2,0" />
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontFamily="Noto Sans SC, Microsoft YaHei UI, Segoe UI"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="12,0,8,0"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="SpecCheck">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="RadioButton" x:Key="SpecRadio">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 平面卡片：圆角 8px，1px 描边，无阴影 -->
        <Style TargetType="Border" x:Key="SectionCard">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderToken}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar (56px, MioLab Spec 04.03: Brand Block + Global Monitor Status & Actions) -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderToken}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Accent}" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="星澪科技" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Width="1" Height="16" Background="#80FFFFFF" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="管理面板" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <DockPanel Grid.Column="1" Margin="16,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgPage}"
                                BorderBrush="{DynamicResource BorderToken}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                ToolTip="一键切换监控画面页面（硬件独占模式下可远程翻页 · Ctrl+Tab / Alt+1 / Alt+2）">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnTopPageOverview"
                                        Content="硬件总览"
                                        Tag="overview"
                                        Style="{StaticResource ActiveSegButton}"
                                        Click="BtnMonitorPage_Click" />
                                <Button x:Name="BtnTopPageProcTree"
                                        Content="进程树"
                                        Tag="proctree"
                                        Style="{StaticResource SegButton}"
                                        Click="BtnMonitorPage_Click" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnToggleFullScreen" Content="切换整屏 / 固定窗口" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="0,0,8,0" Click="BtnToggleFullScreen_Click" />
                        <Button x:Name="BtnCloseDisplay" Content="关闭监控窗口" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="0,0,8,0" Click="BtnCloseDisplay_Click" />
                        <Button x:Name="BtnOpenOrRecreate" Content="重建监控窗口" Style="{StaticResource PrimaryButton}" Padding="14,0" Click="BtnOpenOrRecreate_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusBadge" CornerRadius="99" Padding="12,4" Background="{DynamicResource SuccessSubtle}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadgeText" Text="运行中" Foreground="{DynamicResource Success}" FontSize="14" FontWeight="Medium" />
                        </Border>
                        <TextBlock x:Name="StatusDetailText"
                                   Text="正在检测目标屏幕..."
                                   Foreground="{DynamicResource TextMain}"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Slim Top-Level Non-Admin Elevation Hint Banner -->
        <Border x:Name="ElevationBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource WarningSubtle}"
                BorderBrush="{DynamicResource Warning}"
                BorderThickness="0,0,0,1"
                Padding="20,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="一键管理员重启"
                            Style="{StaticResource SecondaryButton}"
                            Height="28"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Click="BtnElevate_Click" />
                    <Button Content="本次隐藏"
                            Style="{StaticResource SecondaryButton}"
                            Height="28"
                            Padding="10,0"
                            Click="BtnDismissElevationBanner_Click" />
                </StackPanel>
                <TextBlock Text="当前以标准权限运行：CPU 封装温度、主板风扇转速与部分功耗传感器受限"
                           Foreground="{DynamicResource Warning}"
                           FontSize="13"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!-- Body: Left Navigation Rail (216px) + Right 16:9 Content Pane -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderToken}" BorderThickness="0,0,1,0" Padding="12,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border BorderBrush="{DynamicResource BorderToken}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="F11 整屏 · Esc 退出整屏 · Ctrl+Tab 切页 · Ctrl+, 设置 · Ctrl+1~9 切屏"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="4,0,4,10" />
                                <Button Content="隐藏设置窗口" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="BtnHideToTray_Click" />
                                <Button Content="退出程序" Style="{StaticResource DangerButton}" Click="BtnExitAll_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="所有设置项" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,8" />
                        <Button x:Name="BtnNavWindow" Content="窗口与固定位置" Tag="window" Style="{StaticResource ActiveNavButton}" Click="BtnNav_Click" />
                        <Button x:Name="BtnNavMonitor" Content="外观与硬件监控" Tag="monitor" Style="{StaticResource NavButton}" Click="BtnNav_Click" />
                        <Button x:Name="BtnNavLayout" Content="自定义排版" Tag="layout" Style="{StaticResource NavButton}" Click="BtnNav_Click" />
                        <Button x:Name="BtnNavPro" Content="告警、录制与配置" Tag="pro" Style="{StaticResource NavButton}" Click="BtnNav_Click" />
                        <Button x:Name="BtnNavMarket" Content="行情、K 线与标的" Tag="market" Style="{StaticResource NavButton}" Click="BtnNav_Click" />
                        <Button x:Name="BtnNavDonate" Content="赞助支持" Tag="donate" Style="{StaticResource NavButton}" Click="BtnNav_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Right Content Area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <Grid>
                    <!-- ==================== TAB 1: 窗口与固定位置 ==================== -->
                    <Grid x:Name="PanelWindow" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.12*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Card: Monitor, Mode & Behavior -->
                        <Border Grid.Column="0" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="显示屏幕与窗口模式" FontSize="16" FontWeight="Medium" Margin="0,0,0,14" />

                                <TextBlock Text="目标显示器" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ComboMonitors" Grid.Column="0" Style="{StaticResource SpecCombo}" SelectionChanged="ComboMonitors_SelectionChanged" />
                                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnRefreshMonitors_Click" />
                                </Grid>
                                <TextBlock x:Name="MonitorGeometryHint"
                                           Text="工作区：—"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontFamily="JetBrains Mono, Consolas, Noto Sans SC"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />

                                <TextBlock Text="显示模式" Style="{StaticResource FieldLabel}" />
                                <StackPanel Margin="0,0,0,12">
                                    <RadioButton x:Name="RadioFullScreen" Content="占用整块屏幕（桌面无边框全屏）" GroupName="DispMode" Style="{StaticResource SpecRadio}" Margin="0,0,0,2" Checked="RadioMode_Changed" />
                                    <RadioButton x:Name="RadioWindowed" Content="窗口固定显示位置（右侧配置坐标）" GroupName="DispMode" Style="{StaticResource SpecRadio}" Margin="0,0,0,2" Checked="RadioMode_Changed" />
                                    <RadioButton x:Name="RadioDirectExclusive" Content="硬件独占显示器（脱离桌面 · Direct Display）" GroupName="DispMode" Style="{StaticResource SpecRadio}" Checked="RadioMode_Changed" />
                                </StackPanel>

                                <TextBlock Text="跨显卡渲染模式" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ComboRenderMode" Style="{StaticResource SpecCombo}" Margin="0,0,0,12" SelectionChanged="ComboRenderMode_SelectionChanged">
                                    <ComboBoxItem Tag="safe" Content="跨显卡安全模式（推荐 · 防双显卡黑屏）" />
                                    <ComboBoxItem Tag="nodcomp" Content="禁用 DirectComposition 模式" />
                                    <ComboBoxItem Tag="gpu" Content="原生 GPU 硬件加速（同显卡双屏）" />
                                </ComboBox>

                                <TextBlock Text="窗口展示行为" Style="{StaticResource FieldLabel}" />
                                <CheckBox x:Name="ChkTopMost" Content="监控窗口置顶（默认开启）" Style="{StaticResource SpecCheck}" Checked="ChkTopMost_Changed" Unchecked="ChkTopMost_Changed" />
                                <CheckBox x:Name="ChkPinAllDesktops" Content="跨虚拟桌面常驻与防 Win+D 隐藏（切桌面不消失）" Style="{StaticResource SpecCheck}" Checked="ChkPinAllDesktops_Changed" Unchecked="ChkPinAllDesktops_Changed" />
                                <CheckBox x:Name="ChkHideTopBar" Content="隐藏监控窗口顶栏（纯数据展示）" Style="{StaticResource SpecCheck}" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                                <TextBlock Text="监控窗口不占用任务栏，任务栏仅保留管理面板（设置窗口）。"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Fixed Position Panel OR Hardware Direct Display Panel -->
                        <Grid Grid.Column="2" VerticalAlignment="Top">
                            <!-- A. Hardware Exclusive Direct Display Panel (Visible when RadioDirectExclusive is selected) -->
                            <Border x:Name="DirectDisplayPanel" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                        <TextBlock Text="硬件独占显示器（Direct Display）" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <Border x:Name="DirectStatusPill" CornerRadius="99" Padding="10,3" Background="{DynamicResource BorderToken}" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="DirectStatusPillText" Text="未激活" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Text="选择硬件显示目标" Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ComboDirectTargets" Grid.Column="0" Style="{StaticResource SpecCombo}" SelectionChanged="ComboDirectTargets_SelectionChanged" />
                                        <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnRefreshMonitors_Click" />
                                    </Grid>

                                    <TextBlock Text="硬件扫描输出帧率" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ComboDirectFps" Style="{StaticResource SpecCombo}" Margin="0,0,0,12" SelectionChanged="ComboDirectFps_SelectionChanged">
                                        <ComboBoxItem Tag="5" Content="5 FPS（超低占用）" />
                                        <ComboBoxItem Tag="10" Content="10 FPS（推荐 · 流畅且省电）" />
                                        <ComboBoxItem Tag="15" Content="15 FPS（较高流畅度）" />
                                        <ComboBoxItem Tag="30" Content="30 FPS（高刷输出）" />
                                    </ComboBox>

                                    <TextBlock Text="画面旋转（屏幕倒装 / 竖装时调整）" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ComboDirectRotation" Style="{StaticResource SpecCombo}" Margin="0,0,0,12" SelectionChanged="ComboDirectRotation_SelectionChanged">
                                        <ComboBoxItem Tag="0" Content="0°（不旋转）" />
                                        <ComboBoxItem Tag="90" Content="顺时针 90°（竖屏）" />
                                        <ComboBoxItem Tag="180" Content="180°（上下颠倒）" />
                                        <ComboBoxItem Tag="270" Content="顺时针 270°（竖屏 · 反向）" />
                                    </ComboBox>

                                    <Border x:Name="DirectInfoBox"
                                            Background="{DynamicResource BgPage}"
                                            BorderBrush="{DynamicResource BorderToken}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtDirectDisplayStatus"
                                                   Text="使用方式：先在 Windows 设置中对副屏开启「从桌面删除显示器」，再在此选择带有「已脱离桌面」标记的目标即可彻底脱离桌面硬件独占，切桌面 / Win+D / 全屏游戏均不会影响该屏。"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <Border x:Name="DirectDiagBox"
                                            Visibility="Collapsed"
                                            Background="{DynamicResource BgPage}"
                                            BorderBrush="{DynamicResource BorderToken}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6"
                                            Margin="0,0,0,10">
                                        <TextBlock x:Name="TxtDirectDiagStats"
                                                   FontFamily="JetBrains Mono, Consolas, Noto Sans SC"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMain}"
                                                   TextWrapping="Wrap"
                                                   Text="—" />
                                    </Border>

                                    <DockPanel LastChildFill="False">
                                        <Button Content="打开 Windows「从桌面删除显示器」设置" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left" Click="BtnOpenWinDisplaySettings_Click" />
                                        <Button Content="立即独占启动" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="BtnStartDirectDisplay_Click" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- B. Fixed Position Presets, Coordinates & Lock -->
                            <Border x:Name="FixedWindowPanel" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="窗口固定显示位置" FontSize="16" FontWeight="Medium" DockPanel.Dock="Left" />
                                    <TextBlock x:Name="PresetStatusText" Text="当前：自定义坐标" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource AccentText}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <UniformGrid Rows="3" Columns="3" Margin="0,0,0,14">
                                    <Button x:Name="BtnPresetTopLeft" Content="左上角" Tag="top-left" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />
                                    <Button x:Name="BtnPresetTopHalf" Content="上半屏" Tag="top-half" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />
                                    <Button x:Name="BtnPresetTopRight" Content="右上角" Tag="top-right" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />

                                    <Button x:Name="BtnPresetLeftHalf" Content="左半屏" Tag="left-half" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />
                                    <Button x:Name="BtnPresetCenter" Content="屏幕居中" Tag="center" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />
                                    <Button x:Name="BtnPresetRightHalf" Content="右半屏" Tag="right-half" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />

                                    <Button x:Name="BtnPresetBottomLeft" Content="左下角" Tag="bottom-left" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />
                                    <Button x:Name="BtnPresetBottomHalf" Content="下半屏" Tag="bottom-half" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />
                                    <Button x:Name="BtnPresetBottomRight" Content="右下角" Tag="bottom-right" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" />
                                </UniformGrid>

                                <!-- Labeled Coordinate Inputs -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="X 偏移 (px)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtPosX" Style="{StaticResource SpecTextBox}" FontFamily="JetBrains Mono, Consolas" Tag="如 0" KeyDown="PosInput_KeyDown" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Y 偏移 (px)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtPosY" Style="{StaticResource SpecTextBox}" FontFamily="JetBrains Mono, Consolas" Tag="如 0" KeyDown="PosInput_KeyDown" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="贴边边距" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtMargin" Style="{StaticResource SpecTextBox}" FontFamily="JetBrains Mono, Consolas" Tag="0" KeyDown="PosInput_KeyDown" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="窗口宽度 W (px)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtPosW" Style="{StaticResource SpecTextBox}" FontFamily="JetBrains Mono, Consolas" Tag="最小 420" KeyDown="PosInput_KeyDown" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="窗口高度 H (px)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtPosH" Style="{StaticResource SpecTextBox}" FontFamily="JetBrains Mono, Consolas" Tag="最小 300" KeyDown="PosInput_KeyDown" />
                                    </StackPanel>
                                    <Button Grid.Row="2" Grid.Column="4" Content="应用" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Click="BtnApplyCoords_Click" />
                                </Grid>

                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button Content="640×420" Tag="640,420" Style="{StaticResource SecondaryButton}" Padding="10,0" Margin="0,0,6,0" Click="BtnQuickSize_Click" />
                                        <Button Content="960×640" Tag="960,640" Style="{StaticResource SecondaryButton}" Padding="10,0" Margin="0,0,6,0" Click="BtnQuickSize_Click" />
                                        <Button Content="1280×760" Tag="1280,760" Style="{StaticResource SecondaryButton}" Padding="10,0" Click="BtnQuickSize_Click" />
                                    </StackPanel>
                                    <Button x:Name="BtnCaptureCurrentPos" Content="读取当前位置" Style="{StaticResource SecondaryButton}" Padding="10,0" DockPanel.Dock="Right" Click="BtnCaptureCurrentPos_Click" />
                                </DockPanel>

                                <CheckBox x:Name="ChkLockPosition"
                                          Content="锁定窗口位置与大小（禁止鼠标拖动与缩放）"
                                          Style="{StaticResource SpecCheck}"
                                          Checked="ChkLockPosition_Changed"
                                          Unchecked="ChkLockPosition_Changed" />
                                <TextBlock x:Name="LockHintText"
                                           Text="已锁定：监控窗口严格固定在设定坐标，重启后自动恢复。"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0" />
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== TAB 2: 外观与硬件监控 ==================== -->
                    <Grid x:Name="PanelMonitor" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Appearance & Hardware Display + Page/Process Tree Remote Control -->
                        <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="监控画面与硬件显示" FontSize="16" FontWeight="Medium" Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="布局视图" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboLayout" Style="{StaticResource SpecCombo}" SelectionChanged="ComboVisual_Changed">
                                            <ComboBoxItem x:Name="ItemLayoutSplit" Tag="split" Content="综合看板（性能 + K 线）" />
                                            <ComboBoxItem Tag="hardware" Content="性能专注模式" />
                                            <ComboBoxItem x:Name="ItemLayoutMarket" Tag="market" Content="行情专注模式" />
                                            <ComboBoxItem Tag="custom" Content="自定义排版" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="界面主题" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboTheme" Style="{StaticResource SpecCombo}" SelectionChanged="ComboVisual_Changed">
                                            <ComboBoxItem Tag="light" Content="浅色（星澪标准）" />
                                            <ComboBoxItem Tag="dark" Content="深色（星澪深色）" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="监控画面风格" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboHudStyle" Style="{StaticResource SpecCombo}" SelectionChanged="ComboVisual_Changed">
                                            <ComboBoxItem Tag="instrument" Content="精密仪器（仪表盘 · 推荐）" />
                                            <ComboBoxItem Tag="flat" Content="星澪扁平（经典极简）" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="采样刷新周期" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboTelemetryInterval" Style="{StaticResource SpecCombo}" SelectionChanged="ComboVisual_Changed">
                                            <ComboBoxItem Tag="500" Content="0.5 秒（最流畅 · 占用较高）" />
                                            <ComboBoxItem Tag="1000" Content="1.0 秒（高响应）" />
                                            <ComboBoxItem Tag="1500" Content="1.5 秒（推荐 · 默认）" />
                                            <ComboBoxItem Tag="3000" Content="3.0 秒（最省电）" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="性能模式（决定传感器刷新频率）" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboPerfMode" Style="{StaticResource SpecCombo}" SelectionChanged="ComboPerfMode_Changed">
                                            <ComboBoxItem Tag="eco" Content="节能 · 低占用（温度功耗 6 秒/次）" />
                                            <ComboBoxItem Tag="balanced" Content="均衡 · 默认（温度功耗 3 秒/次）" />
                                            <ComboBoxItem Tag="realtime" Content="实时 · 高精度（温度功耗 1 秒/次）" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="高占用进程排序" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboProcSort" Style="{StaticResource SpecCombo}" SelectionChanged="ComboVisual_Changed">
                                            <ComboBoxItem Tag="cpu" Content="按 CPU 占用降序" />
                                            <ComboBoxItem Tag="mem" Content="按内存占用降序" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="PanelCpuViewField" Grid.Column="0">
                                        <TextBlock Text="CPU 视图模式" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboCpuView" Style="{StaticResource SpecCombo}" SelectionChanged="ComboVisual_Changed">
                                            <ComboBoxItem Tag="compact" Content="紧凑核心格（推荐 · 省空间）" />
                                            <ComboBoxItem Tag="cores" Content="完整多核曲线（任务管理器）" />
                                            <ComboBoxItem Tag="overall" Content="仅总体曲线" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="PanelColorSchemeField" Grid.Column="2">
                                        <TextBlock Text="涨跌色系" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboColors" Style="{StaticResource SpecCombo}" SelectionChanged="ComboVisual_Changed">
                                            <ComboBoxItem Tag="cn" Content="红涨绿跌（国内）" />
                                            <ComboBoxItem Tag="global" Content="绿涨红跌（国际）" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="配色皮肤（与主题叠加，同步作用于管理面板与监控窗口）" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                <UniformGrid x:Name="SkinSwatchGrid" Rows="2" Columns="3" Margin="0,0,0,2" />
                                <CheckBox x:Name="ChkOledTrueBlack"
                                          Content="OLED 纯黑模式（深色主题下启用 #000000 护屏纯黑背景）"
                                          Style="{StaticResource SpecCheck}"
                                          Margin="0,8,0,0"
                                          Checked="ChkOption_Changed"
                                          Unchecked="ChkOption_Changed" />

                                <Border BorderBrush="{DynamicResource BorderToken}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="多路 CPU 显示方式" Style="{StaticResource FieldLabel}" Margin="0" DockPanel.Dock="Left" />
                                            <TextBlock x:Name="TxtCpuTopologyInfo"
                                                       Text="检测处理器中"
                                                       FontFamily="JetBrains Mono, Consolas, Noto Sans SC"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       DockPanel.Dock="Right" />
                                        </DockPanel>
                                        <ComboBox x:Name="ComboCpuDisplayTarget" Style="{StaticResource SpecCombo}" SelectionChanged="ComboCpuDisplayTarget_Changed" />
                                        <TextBlock Text="支持双路 / 多路物理 CPU 分路独立展示核心曲线、频率、温度与功耗，也可合并总览或单独聚焦某一颗 CPU。"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Page Switcher & Process/Thread Tree Remote Control Card -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <TextBlock Text="页面切换与进程线程树控制" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                    <Border x:Name="ProcTreeStatusBadge" CornerRadius="99" Padding="10,3" Background="{DynamicResource BorderToken}" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtProcTreeStatusText" Text="硬件总览" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                </DockPanel>

                                <TextBlock Text="当前监控页面" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ComboMonitorPage" Style="{StaticResource SpecCombo}" Margin="0,0,0,12" SelectionChanged="ComboMonitorPage_Changed">
                                    <ComboBoxItem Tag="overview" Content="硬件监控总览（默认 · 零进程树开销）" />
                                    <ComboBoxItem Tag="proctree" Content="进程与线程树（Process Hacker 风格）" />
                                </ComboBox>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="进程列表视图" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboProcTreeViewMode" Style="{StaticResource SpecCombo}" SelectionChanged="ComboProcTreeOption_Changed">
                                            <ComboBoxItem Tag="tree" Content="树状层级（父子进程树）" />
                                            <ComboBoxItem Tag="flat" Content="扁平排行（高负载优先）" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="进程树排序依据" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ComboProcTreeSortBy" Style="{StaticResource SpecCombo}" SelectionChanged="ComboProcTreeOption_Changed">
                                            <ComboBoxItem Tag="cpu" Content="按 CPU 占用" />
                                            <ComboBoxItem Tag="mem" Content="按内存占用" />
                                            <ComboBoxItem Tag="io" Content="按磁盘 I/O" />
                                            <ComboBoxItem Tag="threads" Content="按线程数量" />
                                            <ComboBoxItem Tag="handles" Content="按句柄数量" />
                                            <ComboBoxItem Tag="pid" Content="按 PID 编号" />
                                            <ComboBoxItem Tag="name" Content="按进程名称" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="ChkProcTreeAutoFollow"
                                          Content="自动追踪最高负载进程（独占屏幕推荐）"
                                          Style="{StaticResource SpecCheck}"
                                          Margin="0,0,0,10"
                                          Checked="ChkProcTreeAutoFollow_Changed"
                                          Unchecked="ChkProcTreeAutoFollow_Changed" />

                                <TextBlock Text="线程剖析目标进程（远程锁定）" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ComboProcTreeTarget"
                                          Style="{StaticResource SpecCombo}"
                                          Margin="0,0,0,10"
                                          SelectionChanged="ComboProcTreeTarget_Changed"
                                          DropDownClosed="ComboProcTreeTarget_DropDownClosed" />

                                <TextBlock Text="进程名称 / PID 筛选" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtProcTreeFilter"
                                             Grid.Column="0"
                                             Style="{StaticResource SpecTextBox}"
                                             FontFamily="JetBrains Mono, Consolas, Noto Sans SC"
                                             Tag="输入进程名或 PID（回车生效）"
                                             KeyDown="ProcTreeFilter_KeyDown" />
                                    <Button Grid.Column="1" Content="筛选" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="BtnApplyProcTreeFilter_Click" />
                                    <Button Grid.Column="2" Content="清除" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="6,0,0,0" Click="BtnClearProcTreeFilter_Click" />
                                </Grid>

                                <TextBlock Text="桌面窗口模式可在监控画面中直接点击进程行、展开节点或按 Ctrl+Tab / Alt+1 / Alt+2 切页；硬件独占模式无鼠标交互，可在此面板、顶栏按钮或托盘菜单远程翻页并锁定线程剖析目标。"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <!-- Right Column: Network IP Control + Startup/Elevation -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="网络出口 IPv4 检测" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <Button x:Name="BtnRefreshIp" Content="刷新 IP" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="BtnRefreshIp_Click" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="国内站 IP" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="TxtDomesticIpInfo" Grid.Row="0" Grid.Column="1" Text="检测中" FontFamily="JetBrains Mono, Consolas, Noto Sans SC" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="国外站 IP" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="TxtOverseasIpInfo" Grid.Row="2" Grid.Column="1" Text="检测中" FontFamily="JetBrains Mono, Consolas, Noto Sans SC" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="网络延迟" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="TxtNetworkPingInfo" Grid.Row="4" Grid.Column="1" Text="探测中" FontFamily="JetBrains Mono, Consolas, Noto Sans SC" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <CheckBox x:Name="ChkMaskPublicIp"
                                              Content="隐私模式：隐藏公网 IP 中间段（直播 / 截图防泄露）"
                                              Style="{StaticResource SpecCheck}"
                                              Margin="0,8,0,0"
                                              Checked="ChkOption_Changed"
                                              Unchecked="ChkOption_Changed" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="启动、托盘与传感器权限" FontSize="16" FontWeight="Medium" Margin="0,0,0,10" />
                                    <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（登录后静默恢复上次显示模式）" Style="{StaticResource SpecCheck}" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed" />
                                    <TextBlock x:Name="TxtAutoStartSummary"
                                               Text="开机自启将静默恢复上次显示模式与目标屏幕。"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,6" />
                                    <CheckBox x:Name="ChkAutoOpenDisplay" Content="手动启动时自动打开监控窗口" Style="{StaticResource SpecCheck}" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                                    <CheckBox x:Name="ChkShowControl" Content="手动启动时打开管理面板" Style="{StaticResource SpecCheck}" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                                    <CheckBox x:Name="ChkMinTray" Content="关闭管理面板时隐藏到系统托盘（监控窗口打开时保持后台运行）" Style="{StaticResource SpecCheck}" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                                    <CheckBox x:Name="ChkOled" Content="OLED 防烧屏微位移" Style="{StaticResource SpecCheck}" Margin="0,0,0,10" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />

                                    <Border BorderBrush="{DynamicResource BorderToken}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <DockPanel LastChildFill="False">
                                            <Button x:Name="BtnElevate" Content="以管理员重启" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="BtnElevate_Click" />
                                            <TextBlock x:Name="ElevateText"
                                                       Text="CPU 封装温度需管理员权限"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                        <TextBlock Text="软件更新" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <Border CornerRadius="99" Padding="10,3" Background="{DynamicResource BorderToken}" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCurrentVersionBadge" Text="—" FontFamily="JetBrains Mono, Consolas" FontSize="14" Foreground="{DynamicResource TextMuted}" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock x:Name="TxtUpdateStatusSummary"
                                               Text="—"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextMain}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkAutoCheckUpdates"
                                              Content="启动时自动检查新版本（GitHub Releases）"
                                              Style="{StaticResource SpecCheck}"
                                              Margin="0,0,0,8"
                                              Checked="ChkOption_Changed"
                                              Unchecked="ChkOption_Changed" />

                                    <Border x:Name="PanelIgnoredVersion"
                                            Background="{DynamicResource BgPage}"
                                            BorderBrush="{DynamicResource BorderToken}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6"
                                            Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock x:Name="TxtIgnoredVersionInfo"
                                                       Text="已忽略版本：—"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center"
                                                       DockPanel.Dock="Left" />
                                            <Button Content="取消忽略"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="30"
                                                    Padding="10,0"
                                                    DockPanel.Dock="Right"
                                                    Click="BtnClearIgnoredUpdate_Click" />
                                        </DockPanel>
                                    </Border>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Button x:Name="BtnCheckUpdate" Content="检查更新" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCheckUpdate_Click" />
                                            <Button x:Name="BtnOpenUpdateDialog" Content="查看并下载" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="BtnOpenUpdateDialog_Click" />
                                        </StackPanel>
                                        <Button Content="发布记录" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="BtnOpenReleasesPage_Click" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ==================== TAB 3: 自定义排版编辑器 ==================== -->
                    <Grid x:Name="PanelLayout" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.38*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Card: Interactive Visual Grid Canvas -->
                        <Border Grid.Column="0" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <TextBlock Text="可视化排版画布" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                    <Border x:Name="LayoutActiveBadge" CornerRadius="99" Padding="10,3" Background="{DynamicResource BorderToken}" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="LayoutActiveBadgeText" Text="未启用" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                </DockPanel>

                                <!-- One-Click Layout Presets -->
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="预设模板：" FontSize="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <Button x:Name="BtnPresetSplit" Content="综合看板" Tag="split" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="0,0,6,4" Click="BtnLayoutPreset_Click" />
                                    <Button Content="纯硬件大屏" Tag="hardware" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="0,0,6,4" Click="BtnLayoutPreset_Click" />
                                    <Button Content="竖屏副屏" Tag="portrait" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="0,0,6,4" Click="BtnLayoutPreset_Click" />
                                    <Button Content="机箱长条屏" Tag="bar" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="0,0,6,4" Click="BtnLayoutPreset_Click" />
                                    <Button x:Name="BtnPresetTrading" Content="极简盯盘" Tag="trading" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="0,0,0,4" Click="BtnLayoutPreset_Click" />
                                </WrapPanel>

                                <!-- Interactive Drag & Resize Grid Canvas -->
                                <Border Background="{DynamicResource BgPage}"
                                        BorderBrush="{DynamicResource BorderToken}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,10">
                                    <Canvas x:Name="LayoutEditorCanvas"
                                            Height="252"
                                            ClipToBounds="True"
                                            Background="Transparent"
                                            SizeChanged="LayoutEditorCanvas_SizeChanged"
                                            MouseMove="LayoutEditorCanvas_MouseMove"
                                            MouseLeftButtonUp="LayoutEditorCanvas_MouseLeftButtonUp" />
                                </Border>

                                <Border x:Name="LayoutOverlapBanner"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource DangerSubtle}"
                                        BorderBrush="{DynamicResource Danger}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,6"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="检测到卡片位置重叠，可拖动调整或点击「防重叠整理」一键排布。"
                                               Foreground="{DynamicResource Danger}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               TextWrapping="Wrap" />
                                </Border>

                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button Content="防重叠整理" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="0,0,8,0" Click="BtnLayoutAutoPack_Click" />
                                        <Button Content="重置默认" Style="{StaticResource SecondaryButton}" Padding="12,0" Click="BtnLayoutReset_Click" />
                                    </StackPanel>
                                    <Button x:Name="BtnActivateCustomLayout" Content="启用自定义排版" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="BtnActivateCustomLayout_Click" />
                                </DockPanel>

                                <TextBlock Text="拖动卡片可调整位置，拖动右下角手柄缩放宽高，实时同步监控窗口。"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Grid Settings + Selected Widget Inspector + Module Visibility -->
                        <StackPanel Grid.Column="2">
                            <!-- Grid Dimensions Card -->
                            <Border Style="{StaticResource SectionCard}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="网格参数" FontSize="16" FontWeight="Medium" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="列数" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ComboGridCols" Style="{StaticResource SpecCombo}" SelectionChanged="ComboGridConfig_Changed">
                                                <ComboBoxItem Tag="4" Content="4 列" />
                                                <ComboBoxItem Tag="6" Content="6 列" />
                                                <ComboBoxItem Tag="8" Content="8 列" />
                                                <ComboBoxItem Tag="12" Content="12 列" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="行数" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ComboGridRows" Style="{StaticResource SpecCombo}" SelectionChanged="ComboGridConfig_Changed">
                                                <ComboBoxItem Tag="4" Content="4 行" />
                                                <ComboBoxItem Tag="6" Content="6 行" />
                                                <ComboBoxItem Tag="8" Content="8 行" />
                                                <ComboBoxItem Tag="10" Content="10 行" />
                                                <ComboBoxItem Tag="12" Content="12 行" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="间距" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ComboGridGap" Style="{StaticResource SpecCombo}" SelectionChanged="ComboGridConfig_Changed">
                                                <ComboBoxItem Tag="4" Content="4 px" />
                                                <ComboBoxItem Tag="8" Content="8 px" />
                                                <ComboBoxItem Tag="12" Content="12 px" />
                                                <ComboBoxItem Tag="16" Content="16 px" />
                                                <ComboBoxItem Tag="20" Content="20 px" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Selected Widget Precision Controls -->
                            <Border Style="{StaticResource SectionCard}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtSelectedWidgetTitle" Text="选中：CPU 监控" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" />
                                        <CheckBox x:Name="ChkSelectedWidgetVisible" Content="显示" Style="{StaticResource SpecCheck}" DockPanel.Dock="Right" Checked="ChkSelectedWidgetVisible_Changed" Unchecked="ChkSelectedWidgetVisible_Changed" />
                                    </DockPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Col -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="起始列 (X)" Style="{StaticResource FieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="−" Tag="col,-1" Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnWidgetStep_Click" />
                                                <TextBlock x:Name="TxtWidgetCol" Grid.Column="1" Text="1" FontFamily="JetBrains Mono, Consolas" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="+" Tag="col,1" Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnWidgetStep_Click" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Row -->
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="起始行 (Y)" Style="{StaticResource FieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="−" Tag="row,-1" Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnWidgetStep_Click" />
                                                <TextBlock x:Name="TxtWidgetRow" Grid.Column="1" Text="1" FontFamily="JetBrains Mono, Consolas" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="+" Tag="row,1" Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnWidgetStep_Click" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- ColSpan -->
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="占宽 (列)" Style="{StaticResource FieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="−" Tag="colSpan,-1" Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnWidgetStep_Click" />
                                                <TextBlock x:Name="TxtWidgetColSpan" Grid.Column="1" Text="6" FontFamily="JetBrains Mono, Consolas" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="+" Tag="colSpan,1" Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnWidgetStep_Click" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- RowSpan -->
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="占高 (行)" Style="{StaticResource FieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="−" Tag="rowSpan,-1" Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnWidgetStep_Click" />
                                                <TextBlock x:Name="TxtWidgetRowSpan" Grid.Column="1" Text="3" FontFamily="JetBrains Mono, Consolas" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="+" Tag="rowSpan,1" Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnWidgetStep_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Quick Module Visibility List -->
                            <Border Style="{StaticResource SectionCard}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="模块开关（点击选中，勾选显隐）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <UniformGrid x:Name="LayoutModulesGrid" Columns="3" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ==================== TAB 4: 告警、录制与配置 ==================== -->
                    <Grid x:Name="PanelPro" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Thermal & Load Alerts + Network Ping Target -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                        <TextBlock Text="硬件温控与负载告警" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <Border x:Name="ProAlertStatusBadge" CornerRadius="99" Padding="10,3" Background="{DynamicResource SuccessSubtle}" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtProAlertStatusText" Text="状态正常" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Success}" />
                                        </Border>
                                    </DockPanel>

                                    <CheckBox x:Name="ChkAlertsEnabled" Content="启用智能温控与负载告警" Style="{StaticResource SpecCheck}" Checked="ChkAlertOption_Changed" Unchecked="ChkAlertOption_Changed" />
                                    <CheckBox x:Name="ChkAlertTrayNotify" Content="触发告警时弹出系统托盘通知" Style="{StaticResource SpecCheck}" Margin="0,0,0,8" Checked="ChkAlertOption_Changed" Unchecked="ChkAlertOption_Changed" />

                                    <WrapPanel Margin="0,0,0,10">
