# 复制为 .env 并填入商户真实参数（.env 已被 .gitignore 忽略，切勿提交到 Git）
PORT=8787
MERCHANT_NAME=星澪科技

# 1. 微信支付商户号（商户平台 -> 产品中心 -> 开发配置）
WECHAT_MCHID=

# 2. 已绑定的 AppID（公众号 / 小程序 / 开放平台移动或网站应用，需在「AppID 账号管理」中绑定）
WECHAT_APPID=

# 3. 商户 API 证书序列号（账户中心 -> API 安全 -> 申请 API 证书）
WECHAT_SERIAL_NO=

# 4. APIv3 密钥（32 位字符串，账户中心 -> API 安全 -> 设置 APIv3 密钥）
WECHAT_APIV3_KEY=

# 5. 商户私钥 apiclient_key.pem（二选一：直接填 PEM 字符串或填本地文件路径）
WECHAT_PRIVATE_KEY_FILE=./apiclient_key.pem
# WECHAT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 6. 回调通知公网 HTTPS 地址（例如 https://donate.miolab.ink/api/donate/wechat/notify）
WECHAT_NOTIFY_URL=https://donate.miolab.ink/api/donate/wechat/notify

# 7. （推荐）微信支付公钥 ID 与公钥文件，用于回调验签（账户中心 -> API 安全 -> 微信支付公钥）
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_FILE=./pub_key.pem
